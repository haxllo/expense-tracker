<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#999999"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0"/>
    
    <!-- Input Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#212121"/>
    
    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#E91E63"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="#9C27B0"/>
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DataGridRowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E0E0E0"/>
    
    <!-- Shadow -->
    <Color x:Key="ShadowColor">#40000000</Color>
    
</ResourceDictionary>
