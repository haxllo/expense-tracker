<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9CA3AF"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB"/>
    
    <!-- Input Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#1A1A1A"/>
    
    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="#8B5CF6"/>
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="DataGridRowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#F3F4F6"/>
    
    <!-- Shadow -->
    <Color x:Key="ShadowColor">#20000000</Color>
    
</ResourceDictionary>
