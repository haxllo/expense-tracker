<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#252526"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#808080"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#3E3E42"/>
    
    <!-- Input Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
    
    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#E91E63"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="#9C27B0"/>
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#252526"/>
    <SolidColorBrush x:Key="DataGridRowBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#333337"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="#094771"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#3E3E42"/>
    
    <!-- Shadow -->
    <Color x:Key="ShadowColor">#80000000</Color>
    
</ResourceDictionary>
