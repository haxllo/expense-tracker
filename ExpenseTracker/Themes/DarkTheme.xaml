<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 🌌 FUTURISTIC DARK THEME - Cyberpunk Fintech Aesthetic -->
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C1F26"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#161B22"/>
    
    <!-- Glassmorphism Card Background -->
    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C1F26" Offset="0"/>
        <GradientStop Color="#21262D" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B7280"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#30363D"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#21262D"/>
    <SolidColorBrush x:Key="GlowBorderBrush" Color="#00FFC6"/>
    
    <!-- Input Colors -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#30363D"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#00FFC6"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
    
    <!-- Neon Accent Colors -->
    <SolidColorBrush x:Key="NeonCyanBrush" Color="#00FFC6"/>
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="#7B61FF"/>
    <SolidColorBrush x:Key="NeonAmberBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="NeonBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="NeonPinkBrush" Color="#EC4899"/>
    
    <!-- Gradient Brushes for Cards -->
    <LinearGradientBrush x:Key="CyanGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFC6" Offset="0"/>
        <GradientStop Color="#00D9A8" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PurpleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0"/>
        <GradientStop Color="#7B61FF" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="BlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="AmberGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#D97706" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PinkGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0"/>
        <GradientStop Color="#DB2777" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
    
    <!-- Legacy Accent Colors (for compatibility) -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#00FFC6"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#00FFC6"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="#EC4899"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="#7B61FF"/>
    
    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="DataGridRowBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="#1C2B3A"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#21262D"/>
    
    <!-- Shadow & Glow -->
    <Color x:Key="ShadowColor">#80000000</Color>
    <Color x:Key="CyanGlowColor">#4000FFC6</Color>
    <Color x:Key="PurpleGlowColor">#407B61FF</Color>
    
</ResourceDictionary>
