<Window x:Class="ExpenseTracker.Views.BudgetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Monthly Budgets" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="💰 Set Monthly Budgets" FontSize="24" FontWeight="Bold" 
                      Foreground="#333"/>
            <TextBlock Text="Set spending limits for each category" FontSize="14" Foreground="#666" 
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Budget List -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryBudgets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                   Padding="0,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" 
                                               VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryIcon, Mode=OneWay}" 
                                                  FontSize="24" VerticalAlignment="Center" 
                                                  Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CategoryName, Mode=OneWay}" 
                                                      FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" 
                                                      FontSize="12" Foreground="{Binding ProgressBarColor, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Budget Input & Progress -->
                                    <StackPanel Grid.Column="1" Margin="20,0" 
                                               VerticalAlignment="Center">
                                        <!-- Progress Bar -->
                                        <ProgressBar Minimum="0" Maximum="100" 
                                                    Value="{Binding PercentageUsed, Mode=OneWay}"
                                                    Height="12" Margin="0,0,0,5"
                                                    Foreground="{Binding ProgressBarColor, Mode=OneWay}"/>
                                        
                                        <!-- Spent / Budget -->
                                        <TextBlock FontSize="12" Foreground="#666">
                                            <Run Text="Spent: ₹"/>
                                            <Run Text="{Binding Spent, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" / ₹"/>
                                            <Run Text="{Binding BudgetLimit, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding PercentageUsed, StringFormat=F1, Mode=OneWay}"/>
                                            <Run Text="%)"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Budget Input -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Budget Limit" FontSize="11" 
                                                  Foreground="#666" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="₹" FontSize="16" 
                                                      VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding BudgetLimit, UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="100" FontSize="14" Padding="8"
                                                    BorderBrush="#DDD" BorderThickness="1">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="White" 
                                                                           BorderBrush="{TemplateBinding BorderBrush}"
                                                                           BorderThickness="{TemplateBinding BorderThickness}"
                                                                           CornerRadius="5">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" 
                   Margin="0,20,0,0">
            <Button Content="💾 Save Budgets" Command="{Binding SaveCommand}"
                   Padding="25,12" Margin="5,0" FontSize="16" FontWeight="SemiBold"
                   Background="#4CAF50" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="❌ Cancel" Command="{Binding CancelCommand}"
                   Padding="25,12" Margin="5,0" FontSize="16" FontWeight="SemiBold"
                   Background="#757575" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#616161"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
