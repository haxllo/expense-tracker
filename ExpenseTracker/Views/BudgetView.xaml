<Window x:Class="ExpenseTracker.Views.BudgetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Monthly Budgets" Height="700" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}" 
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Set Monthly Budgets" 
                      Style="{StaticResource Heading2}"/>
            <TextBlock Text="Set spending limits for each category" 
                      Style="{StaticResource BodyText}"
                      Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Budget List -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryBudgets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" 
                                   Padding="0,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" 
                                               VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryIcon, Mode=OneWay}" 
                                                  FontSize="24" VerticalAlignment="Center" 
                                                  Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CategoryName, Mode=OneWay}" 
                                                      FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" 
                                                      FontSize="12" Foreground="{Binding ProgressBarColor, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Budget Input & Progress -->
                                    <StackPanel Grid.Column="1" Margin="20,0" 
                                               VerticalAlignment="Center">
                                        <!-- Progress Bar -->
                                        <ProgressBar Minimum="0" Maximum="100" 
                                                    Value="{Binding PercentageUsed, Mode=OneWay}"
                                                    Height="12" Margin="0,0,0,5"
                                                    Foreground="{Binding ProgressBarColor, Mode=OneWay}"/>
                                        
                                        <!-- Spent / Budget -->
                                        <TextBlock FontSize="12" Foreground="#666">
                                            <Run Text="Spent: ₹"/>
                                            <Run Text="{Binding Spent, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" / ₹"/>
                                            <Run Text="{Binding BudgetLimit, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding PercentageUsed, StringFormat=F1, Mode=OneWay}"/>
                                            <Run Text="%)"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Budget Input -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Budget Limit" 
                                                  Style="{StaticResource ModernLabel}"
                                                  Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="₹" FontSize="16" 
                                                      VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding BudgetLimit, UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="120" 
                                                    Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,24,0,0">
            <Button Content="Cancel" 
                   Command="{Binding CancelCommand}"
                   Style="{StaticResource SecondaryButton}"
                   Margin="0,0,8,0"/>
            <Button Content="Save Budgets" 
                   Command="{Binding SaveCommand}"
                   Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
