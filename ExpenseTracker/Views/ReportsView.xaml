<Window x:Class="ExpenseTracker.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Reports and Analytics" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Reports and Analytics" 
                      Style="{StaticResource Heading1}"
                      VerticalAlignment="Center"/>
            
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Content="Refresh" 
                       Command="{Binding RefreshCommand}"
                       Style="{StaticResource PrimaryButton}"
                       Margin="0,0,8,0"/>
                <Button Content="Close" 
                       Click="CloseButton_Click"
                       Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Summary Cards & Date Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Total Amount Card -->
            <Border Grid.Column="0" 
                   Style="{StaticResource StatsCard}" 
                   Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Expenses" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}" 
                              Style="{StaticResource StatsValue}"
                              Foreground="{StaticResource AccentMintBrush}"/>
                </StackPanel>
            </Border>

            <!-- Average Daily Card -->
            <Border Grid.Column="1" 
                   Style="{StaticResource StatsCard}" 
                   Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Daily Average" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding AverageDaily, StringFormat=₹{0:N2}}" 
                              Style="{StaticResource StatsValue}"/>
                </StackPanel>
            </Border>

            <!-- Top Category Card -->
            <Border Grid.Column="2" 
                   Style="{StaticResource StatsCard}" 
                   Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="Top Category" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TopCategory}" 
                              Style="{StaticResource StatsValue}"
                              Foreground="{StaticResource AccentVioletBrush}"/>
                </StackPanel>
            </Border>

            <!-- Date Range Selector -->
            <Border Grid.Column="3" 
                   Style="{StaticResource StatsCard}"
                   Padding="20" 
                   Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From" 
                              Style="{StaticResource BodyText}"
                              VerticalAlignment="Center" 
                              Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" 
                               Style="{StaticResource ModernDatePicker}"
                               Width="130" 
                               Margin="0,0,12,0"/>
                    <TextBlock Text="To" 
                              Style="{StaticResource BodyText}"
                              VerticalAlignment="Center" 
                              Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" 
                               Style="{StaticResource ModernDatePicker}"
                               Width="130"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Charts Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Category Pie Chart -->
                <Border Style="{StaticResource DashboardCard}" 
                       Padding="24" 
                       Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="350"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Expenses by Category" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,16"/>
                        
                        <lvc:PieChart Grid.Row="1" Series="{Binding CategoryPieChart}"
                                     LegendPosition="Right"
                                     InitialRotation="-90">
                        </lvc:PieChart>
                    </Grid>
                </Border>

                <!-- Monthly Bar Chart -->
                <Border Style="{StaticResource DashboardCard}" 
                       Padding="24" 
                       Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Monthly Spending Trends (Last 6 Months)" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,16"/>
                        
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlyBarChart}"
                                           XAxes="{Binding MonthlyXAxis}"
                                           LegendPosition="Bottom">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- Daily Line Chart -->
                <Border Style="{StaticResource DashboardCard}" 
                       Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Daily Spending Pattern (Last 30 Days)" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,16"/>
                        
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding DailyLineChart}"
                                           XAxes="{Binding DailyXAxis}"
                                           LegendPosition="Bottom">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
