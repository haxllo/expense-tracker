<Window x:Class="ExpenseTracker.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Reports and Analytics" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource PrimaryFont}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <!-- Custom Button Style - No Shadow on Hover, Reduced Contrast -->
        <Style x:Key="NoShadowRaisedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Height" Value="37"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E2E"/>
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="37"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Reports and Analytics" 
                      Style="{StaticResource Heading1}"
                      VerticalAlignment="Center"/>
            
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                       Style="{StaticResource NoShadowRaisedButton}"
                       Padding="20,0"
                       Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="CloseButton_Click"
                       Style="{StaticResource CloseButtonStyle}"
                       Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Close" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards & Date Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Total Amount Card -->
            <materialDesign:Card Grid.Column="0" 
                                Margin="0,0,6,0"
                                Padding="12"
                                UniformCornerRadius="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel>
                    <TextBlock Text="Total Expenses" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=₹{0:N2}}" 
                              Style="{StaticResource StatsValue}"
                              Foreground="#171717"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Average Daily Card -->
            <materialDesign:Card Grid.Column="1" 
                                Margin="3,0"
                                Padding="12"
                                UniformCornerRadius="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel>
                    <TextBlock Text="Daily Average" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding AverageDaily, StringFormat=₹{0:N2}}" 
                              Style="{StaticResource StatsValue}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Top Category Card -->
            <materialDesign:Card Grid.Column="2" 
                                Margin="3,0,6,0"
                                Padding="12"
                                UniformCornerRadius="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel>
                    <TextBlock Text="Top Category" 
                              Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TopCategory}" 
                              Style="{StaticResource StatsValue}"
                              Foreground="#171717"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Date Range Selector -->
            <materialDesign:Card Grid.Column="3" 
                                Padding="12"
                                Margin="6,0,0,0"
                                UniformCornerRadius="6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From" 
                              Style="{StaticResource BodyText}"
                              VerticalAlignment="Center" 
                              Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" 
                               Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                               Width="110" 
                               Margin="0,0,8,0"/>
                    <TextBlock Text="To" 
                              Style="{StaticResource BodyText}"
                              VerticalAlignment="Center" 
                              Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" 
                               Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                               Width="110"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Charts Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Category Pie Chart -->
                <materialDesign:Card Padding="16" 
                                    Margin="0,0,0,12"
                                    UniformCornerRadius="8"
                                    BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="240"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Expenses by Category" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,12"/>
                        
                        <lvc:PieChart Grid.Row="1" Series="{Binding CategoryPieChart}"
                                     LegendPosition="Right"
                                     InitialRotation="-90">
                        </lvc:PieChart>
                    </Grid>
                </materialDesign:Card>

                <!-- Monthly Bar Chart -->
                <materialDesign:Card Padding="16" 
                                    Margin="0,0,0,12"
                                    UniformCornerRadius="8"
                                    BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Monthly Spending Trends (Last 6 Months)" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,12"/>
                        
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlyBarChart}"
                                           XAxes="{Binding MonthlyXAxis}"
                                           LegendPosition="Bottom">
                        </lvc:CartesianChart>
                    </Grid>
                </materialDesign:Card>

                <!-- Daily Line Chart -->
                <materialDesign:Card Padding="16"
                                    UniformCornerRadius="8"
                                    BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                  Text="Daily Spending Pattern (Last 30 Days)" 
                                  Style="{StaticResource Heading3}"
                                  Margin="0,0,0,12"/>
                        
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding DailyLineChart}"
                                           XAxes="{Binding DailyXAxis}"
                                           LegendPosition="Bottom">
                        </lvc:CartesianChart>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
