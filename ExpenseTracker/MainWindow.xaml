<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ExpenseTracker.Helpers"
        mc:Ignorable="d"
        Title="Expense Tracker" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <helpers:TextLengthToVisibilityConverter x:Key="TextLengthToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Stats Cards -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="*"/>      <!-- Table -->
            <RowDefinition Height="Auto"/>   <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <StackPanel>
                <TextBlock Text="Expense Tracker" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Track and manage your expenses efficiently" 
                          Foreground="{StaticResource TextSecondaryBrush}" 
                          FontSize="14" 
                          Margin="0,4,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add Expense" 
                       Command="{Binding AddExpenseCommand}"
                       Style="{StaticResource PrimaryButton}"
                       Margin="0,0,8,0"/>
                <Button Content="Refresh" 
                       Command="{Binding RefreshCommand}"
                       Style="{StaticResource SecondaryButton}"
                       Margin="0,0,8,0"/>
                <Button Content="Budget" 
                       Command="{Binding ShowBudgetCommand}"
                       Style="{StaticResource SecondaryButton}"
                       Margin="0,0,8,0"/>
                <Button Content="Reports" 
                       Command="{Binding ShowReportsCommand}"
                       Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ========== STATS CARDS ========== -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Expenses -->
            <Border Grid.Column="0" Style="{StaticResource StatsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL EXPENSES" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource AccentMintBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- This Month -->
            <Border Grid.Column="1" Style="{StaticResource StatsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="THIS MONTH" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding MonthlyTotal, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Last 7 Days -->
            <Border Grid.Column="2" Style="{StaticResource StatsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="LAST 7 DAYS" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding WeeklyTotal, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Average Daily -->
            <Border Grid.Column="3" Style="{StaticResource StatsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="AVG DAILY" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding AverageDaily, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Top Category -->
            <Border Grid.Column="4" Style="{StaticResource StatsCard}">
                <StackPanel>
                    <TextBlock Text="TOP CATEGORY" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TopCategory}" 
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource AccentVioletBrush}"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== FILTERS & SEARCH ========== -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Margin="0,0,0,16" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0" 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernTextBox}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="Search expenses..." 
                                                  Foreground="{StaticResource TextTertiaryBrush}"
                                                  Padding="12,10"
                                                  FontSize="13"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, 
                                                              Converter={StaticResource TextLengthToVisibilityConverter}}"/>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,10"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- Date Filters -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <TextBlock Text="From" 
                                  VerticalAlignment="Center" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FilterStartDate}" 
                                   Style="{StaticResource ModernDatePicker}"
                                   Width="130"
                                   Margin="0,0,16,0"/>
                        
                        <TextBlock Text="To" 
                                  VerticalAlignment="Center" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FilterEndDate}" 
                                   Style="{StaticResource ModernDatePicker}"
                                   Width="130"/>
                    </StackPanel>

                    <!-- Sort Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="Sort" 
                                  VerticalAlignment="Center" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  FontSize="11" 
                                  Margin="0,0,8,0"/>
                        <Button Content="Date" 
                               Command="{Binding SortCommand}" 
                               CommandParameter="Date"
                               Style="{StaticResource SecondaryButton}"
                               Padding="10,6" 
                               Margin="0,0,4,0" 
                               FontSize="12"/>
                        <Button Content="Amount" 
                               Command="{Binding SortCommand}" 
                               CommandParameter="Amount"
                               Style="{StaticResource SecondaryButton}"
                               Padding="10,6" 
                               Margin="0,0,4,0" 
                               FontSize="12"/>
                        <Button Content="Category" 
                               Command="{Binding SortCommand}" 
                               CommandParameter="Category"
                               Style="{StaticResource SecondaryButton}"
                               Padding="10,6" 
                               FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Expenses List -->
                <DataGrid Grid.Row="1" 
                         ItemsSource="{Binding Expenses}" 
                         SelectedItem="{Binding SelectedExpense}"
                         Style="{StaticResource ModernDataGrid}"
                         RowStyle="{StaticResource ModernDataGridRow}"
                         ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                         CellStyle="{StaticResource ModernDataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category.Name}" 
                                          Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" 
                                          Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=₹{0:N2}}" 
                                          Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentMintBrush}"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>

        <!-- ========== ACTION BUTTONS ========== -->
        <StackPanel Grid.Row="3" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,16,0,0">
            <Button Content="Edit" 
                   Command="{Binding EditExpenseCommand}"
                   Style="{StaticResource SecondaryButton}"
                   Margin="0,0,8,0"/>
            <Button Content="Delete" 
                   Command="{Binding DeleteExpenseCommand}"
                   Style="{StaticResource DangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
