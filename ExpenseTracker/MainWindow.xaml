<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ExpenseTracker.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Expense Tracker" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource PrimaryFont}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <helpers:TextLengthToVisibilityConverter x:Key="TextLengthToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Stats Cards -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="*"/>      <!-- Table -->
            <RowDefinition Height="Auto"/>   <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <StackPanel>
                <TextBlock Text="Expense Tracker" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Track and manage your expenses efficiently" 
                          Foreground="{StaticResource TextSecondaryBrush}" 
                          FontSize="14" 
                          Margin="0,4,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding AddExpenseCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Background="#171717"
                       Foreground="#FAFAFA"
                       Height="40"
                       Padding="20,0"
                       Margin="0,0,8,0"
                       materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Expense" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Height="40"
                       Padding="20,0"
                       Margin="0,0,8,0"
                       materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowBudgetCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Height="40"
                       Padding="20,0"
                       Margin="0,0,8,0"
                       materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Budget" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowReportsCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Height="40"
                       Padding="20,0"
                       materialDesign:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reports" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== STATS CARDS ========== -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Expenses -->
            <materialDesign:Card Grid.Column="0" 
                                Margin="0,0,12,0" 
                                Padding="20"
                                UniformCornerRadius="8"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL EXPENSES" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource AccentMintBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- This Month -->
            <materialDesign:Card Grid.Column="1" 
                                Margin="0,0,12,0" 
                                Padding="20"
                                UniformCornerRadius="8"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="THIS MONTH" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding MonthlyTotal, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Last 7 Days -->
            <materialDesign:Card Grid.Column="2" 
                                Margin="0,0,12,0" 
                                Padding="20"
                                UniformCornerRadius="8"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="LAST 7 DAYS" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding WeeklyTotal, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Average Daily -->
            <materialDesign:Card Grid.Column="3" 
                                Margin="0,0,12,0" 
                                Padding="20"
                                UniformCornerRadius="8"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="AVG DAILY" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding AverageDaily, StringFormat=₹{0:N0}}" 
                              Style="{StaticResource StatsNumber}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Top Category -->
            <materialDesign:Card Grid.Column="4" 
                                Padding="20"
                                UniformCornerRadius="8"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOP CATEGORY" Style="{StaticResource StatsLabel}"/>
                    <TextBlock Text="{Binding TopCategory}" 
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource AccentVioletBrush}"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- ========== FILTERS & SEARCH ========== -->
        <materialDesign:Card Grid.Row="2" 
                            Margin="0,0,0,16" 
                            Padding="20"
                            UniformCornerRadius="12"
                            materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box with Icon -->
                    <TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="#0A0A0A"
                            materialDesign:HintAssist.Hint="Search expenses..."
                            materialDesign:HintAssist.Foreground="#737373"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                            materialDesign:TextFieldAssist.LeadingIconSize="20" />

                    <!-- Category Dropdown -->
                    <ComboBox Grid.Column="1"
                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                             Height="40"
                             Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="Category"
                             VerticalContentAlignment="Center"
                             FontSize="13">
                        <ComboBoxItem Content="All Categories" IsSelected="True"/>
                        <ComboBoxItem Content="Food"/>
                        <ComboBoxItem Content="Transport"/>
                        <ComboBoxItem Content="Shopping"/>
                        <ComboBoxItem Content="Entertainment"/>
                        <ComboBoxItem Content="Utilities"/>
                    </ComboBox>

                    <!-- Payment Method Dropdown -->
                    <ComboBox Grid.Column="2"
                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                             Height="40"
                             Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="Payment Method"
                             VerticalContentAlignment="Center"
                             FontSize="13">
                        <ComboBoxItem Content="All Methods" IsSelected="True"/>
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Credit Card"/>
                        <ComboBoxItem Content="Debit Card"/>
                        <ComboBoxItem Content="Digital Wallet"/>
                    </ComboBox>

                    <!-- Filter Icon Button -->
                    <Button Grid.Column="3"
                           Style="{StaticResource MaterialDesignIconButton}"
                           Width="40"
                           Height="40"
                           Foreground="{StaticResource TextPrimaryBrush}">
                        <materialDesign:PackIcon Kind="FilterOutline" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <!-- Expenses List -->
                <DataGrid Grid.Row="1" 
                         ItemsSource="{Binding Expenses}" 
                         SelectedItem="{Binding SelectedExpense}"
                         Style="{StaticResource ModernDataGrid}"
                         RowStyle="{StaticResource ModernDataGridRow}"
                         ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                         CellStyle="{StaticResource ModernDataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category.Name}" 
                                          Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" 
                                          Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=₹{0:N2}}" 
                                          Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#171717"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- ========== ACTION BUTTONS ========== -->
        <StackPanel Grid.Row="3" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,16,0,0">
            <Button Command="{Binding EditExpenseCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Height="40"
                   Padding="20,0"
                   Margin="0,0,8,0"
                   materialDesign:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Edit" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteExpenseCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Height="40"
                   Padding="20,0"
                   Foreground="#EF4444"
                   BorderBrush="#EF4444"
                   materialDesign:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Delete" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
