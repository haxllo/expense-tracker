<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ExpenseTracker.Helpers"
        mc:Ignorable="d"
        Title="Expense Tracker" Height="750" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <helpers:TextLengthToVisibilityConverter x:Key="TextLengthToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Expense Tracker" FontSize="24" FontWeight="SemiBold" 
                              Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage your finances with ease" FontSize="12" 
                              Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Add Expense" Command="{Binding AddExpenseCommand}"
                       Padding="15,8" Margin="5,0" FontSize="14" FontWeight="SemiBold"
                       Background="#4CAF50" Foreground="White" BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}"
                       Padding="15,8" Margin="5,0" FontSize="14" FontWeight="SemiBold"
                       Background="#2196F3" Foreground="White" BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="💰 Budget" Command="{Binding ShowBudgetCommand}"
                       Padding="15,8" Margin="5,0" FontSize="14" FontWeight="SemiBold"
                       Background="#FF9800" Foreground="White" BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F57C00"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📊 Reports" Command="{Binding ShowReportsCommand}"
                       Padding="15,8" Margin="5,0" FontSize="14" FontWeight="SemiBold"
                       Background="#9C27B0" Foreground="White" BorderThickness="0"
                       Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7B1FA2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding ThemeIcon}" Command="{Binding ToggleThemeCommand}"
                       Padding="10,8" Margin="10,0,0,0" FontSize="18"
                       Background="#607D8B" Foreground="White" BorderThickness="0"
                       Cursor="Hand" ToolTip="Toggle Theme">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#546E7A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Expenses Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                   Padding="20,16" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL EXPENSES" FontSize="10" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat=₹{0:N0}}" 
                              FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource DangerAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Monthly Total Card with Trend -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                   Padding="20,16" Margin="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THIS MONTH" FontSize="10" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MonthlyTotal, StringFormat=₹{0:N0}}" 
                                  FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessAccentBrush}"/>
                        <TextBlock Text="{Binding TrendIndicator}" 
                                  FontSize="13" FontWeight="Medium" 
                                  Foreground="{Binding TrendColor}"
                                  VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weekly Total Card -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                   Padding="20,16" Margin="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="LAST 7 DAYS" FontSize="10" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding WeeklyTotal, StringFormat=₹{0:N0}}" 
                              FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Average Daily Card -->
            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                   Padding="20,16" Margin="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="AVG DAILY" FontSize="10" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AverageDaily, StringFormat=₹{0:N0}}" 
                              FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WarningAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Top Category Card -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" 
                   Padding="20,16" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="0" Opacity="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOP CATEGORY" FontSize="10" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TopCategory}" 
                              FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InfoAccentBrush}"
                              TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters and Search -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14" Padding="10" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InputTextBrush}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="🔍 Search expenses..." 
                                                              Foreground="{DynamicResource TertiaryTextBrush}" Padding="10"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, 
                                                                          Converter={StaticResource TextLengthToVisibilityConverter}}"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterStartDate}" 
                                   Width="120" Margin="0,0,10,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterEndDate}" Width="120"/>
                    </StackPanel>

                    <!-- Sort Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" 
                                  Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                        <Button Content="📅 Date" Command="{Binding SortCommand}" CommandParameter="Date"
                               Padding="8,5" Margin="2,0" FontSize="11" 
                               Background="{DynamicResource ButtonBackgroundBrush}" Foreground="White" 
                               BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="💰 Amount" Command="{Binding SortCommand}" CommandParameter="Amount"
                               Padding="8,5" Margin="2,0" FontSize="11" 
                               Background="{DynamicResource ButtonBackgroundBrush}" Foreground="White" 
                               BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🏷️ Category" Command="{Binding SortCommand}" CommandParameter="Category"
                               Padding="8,5" Margin="2,0" FontSize="11" 
                               Background="{DynamicResource ButtonBackgroundBrush}" Foreground="White" 
                               BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Expenses List -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" 
                         SelectedItem="{Binding SelectedExpense}"
                         AutoGenerateColumns="False" CanUserAddRows="False"
                         HeadersVisibility="Column" GridLinesVisibility="None"
                         Background="Transparent" BorderThickness="0"
                         RowHeight="50" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                          Width="120"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" 
                                          Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₹{0:N2}}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#E91E63"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternateRowBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" 
                   Margin="0,15,0,0">
            <Button Content="✏️ Edit" Command="{Binding EditExpenseCommand}"
                   Padding="20,10" Margin="5,0" FontSize="14"
                   Background="#FF9800" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F57C00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="🗑️ Delete" Command="{Binding DeleteExpenseCommand}"
                   Padding="20,10" Margin="5,0" FontSize="14"
                   Background="#F44336" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
