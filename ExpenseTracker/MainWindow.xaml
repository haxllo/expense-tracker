<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ExpenseTracker.Helpers"
        mc:Ignorable="d"
        Title="Expense Tracker" Height="750" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Inter, Poppins"
        FontSize="13"
        FontWeight="Normal">
    <Window.Resources>
        <helpers:TextLengthToVisibilityConverter x:Key="TextLengthToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Expense Tracker" FontSize="24" FontWeight="SemiBold" 
                              Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage your finances with ease" FontSize="12" 
                              Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Add Expense" Command="{Binding AddExpenseCommand}"
                       Padding="16,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                       Foreground="White" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource NeonCyanBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00FFC6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#00FFC6" Offset="0"/>
                                                <GradientStop Color="#00D9A8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}"
                       Padding="16,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                       Foreground="White" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource NeonBlueBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NeonBlueBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#60A5FA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="💰 Budget" Command="{Binding ShowBudgetCommand}"
                       Padding="16,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                       Foreground="White" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource NeonAmberBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NeonAmberBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F59E0B" Offset="0"/>
                                                <GradientStop Color="#FBBF24" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📊 Reports" Command="{Binding ShowReportsCommand}"
                       Padding="16,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                       Foreground="White" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource NeonPurpleBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource NeonPurpleBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#7B61FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#A855F7" Offset="0"/>
                                                <GradientStop Color="#C084FC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding ThemeIcon}" Command="{Binding ToggleThemeCommand}"
                       Padding="12,10" Margin="10,0,0,0" FontSize="16"
                       Foreground="White" BorderThickness="1"
                       Cursor="Hand" ToolTip="Toggle Theme">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                    <Setter Property="Background" Value="#21262D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Expenses Card - Neon Pink Glow -->
            <Border Grid.Column="0" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" 
                   Padding="24,20" Margin="0,0,10,0" BorderBrush="{DynamicResource NeonPinkBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#EC4899" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL EXPENSES" FontSize="11" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,12" Opacity="0.8"/>
                    <TextBlock FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EC4899" Offset="0"/>
                                <GradientStop Color="#F472B6" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <Run Text="₹"/><Run Text="{Binding TotalExpenses, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Monthly Total Card - Neon Cyan Glow -->
            <Border Grid.Column="1" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" 
                   Padding="24,20" Margin="10,0" BorderBrush="{DynamicResource NeonCyanBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#00FFC6" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THIS MONTH" FontSize="11" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,12" Opacity="0.8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="32" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFC6" Offset="0"/>
                                    <GradientStop Color="#00D9A8" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="₹"/><Run Text="{Binding MonthlyTotal, StringFormat=N0}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding TrendIndicator}" 
                                  FontSize="14" FontWeight="SemiBold" 
                                  Foreground="{Binding TrendColor}"
                                  VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Weekly Total Card - Neon Blue Glow -->
            <Border Grid.Column="2" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" 
                   Padding="24,20" Margin="10,0" BorderBrush="{DynamicResource NeonBlueBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="LAST 7 DAYS" FontSize="11" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,12" Opacity="0.8"/>
                    <TextBlock FontSize="32" FontWeight="SemiBold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#60A5FA" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <Run Text="₹"/><Run Text="{Binding WeeklyTotal, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Average Daily Card - Neon Amber Glow -->
            <Border Grid.Column="3" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" 
                   Padding="24,20" Margin="10,0" BorderBrush="{DynamicResource NeonAmberBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#F59E0B" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="AVG DAILY" FontSize="11" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,12" Opacity="0.8"/>
                    <TextBlock FontSize="32" FontWeight="SemiBold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <Run Text="₹"/><Run Text="{Binding AverageDaily, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Top Category Card - Neon Purple Glow -->
            <Border Grid.Column="4" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" 
                   Padding="24,20" Margin="10,0,0,0" BorderBrush="{DynamicResource NeonPurpleBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#7B61FF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOP CATEGORY" FontSize="11" FontWeight="Medium" 
                              Foreground="{DynamicResource SecondaryTextBrush}" 
                              Margin="0,0,0,12" Opacity="0.8"/>
                    <TextBlock Text="{Binding TopCategory}" FontSize="22" FontWeight="SemiBold" 
                              TextTrimming="CharacterEllipsis">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A855F7" Offset="0"/>
                                <GradientStop Color="#C084FC" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters and Search -->
        <Border Grid.Row="2" Background="{DynamicResource GlassCardBrush}" CornerRadius="16" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13" Padding="12" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource InputTextBrush}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="10">
                                                <Grid>
                                                    <TextBlock Text="🔍 Search expenses..." 
                                                              Foreground="{DynamicResource TertiaryTextBrush}" Padding="12" FontSize="13" Opacity="0.6"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, 
                                                                          Converter={StaticResource TextLengthToVisibilityConverter}}"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" 
                                  Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Medium" Opacity="0.8"/>
                        <DatePicker SelectedDate="{Binding FilterStartDate}" 
                                   Width="130" Height="38" Margin="0,0,12,0"
                                   Background="{DynamicResource InputBackgroundBrush}"
                                   BorderBrush="{DynamicResource InputBorderBrush}"
                                   Foreground="{DynamicResource InputTextBrush}"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" 
                                  Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Medium" Opacity="0.8"/>
                        <DatePicker SelectedDate="{Binding FilterEndDate}" Width="130" Height="38"
                                   Background="{DynamicResource InputBackgroundBrush}"
                                   BorderBrush="{DynamicResource InputBorderBrush}"
                                   Foreground="{DynamicResource InputTextBrush}"/>
                    </StackPanel>

                    <!-- Sort Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,6,0" 
                                  Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="Medium" Opacity="0.7"/>
                        <Button Content="Date" Command="{Binding SortCommand}" CommandParameter="Date"
                               Padding="10,6" Margin="3,0" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}" 
                               BorderThickness="1" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                       CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#21262D"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Amount" Command="{Binding SortCommand}" CommandParameter="Amount"
                               Padding="10,6" Margin="3,0" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}" 
                               BorderThickness="1" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                       CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#21262D"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Category" Command="{Binding SortCommand}" CommandParameter="Category"
                               Padding="10,6" Margin="3,0" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}" 
                               BorderThickness="1" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                       CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#21262D"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Expenses List -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" 
                         SelectedItem="{Binding SelectedExpense}"
                         AutoGenerateColumns="False" CanUserAddRows="False"
                         HeadersVisibility="Column" GridLinesVisibility="None"
                         Background="Transparent" BorderThickness="0"
                         RowHeight="48" FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                          Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category.Name}" 
                                          Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" 
                                          Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" 
                                          Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=₹{0:N2}}" 
                                          Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NeonPinkBrush}"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternateRowBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1C2128"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" 
                   Margin="0,15,0,0">
            <Button Content="✏️ Edit" Command="{Binding EditExpenseCommand}"
                   Padding="18,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                   Foreground="White" BorderThickness="1" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource NeonAmberBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource NeonAmberBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#FBBF24" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="🗑️ Delete" Command="{Binding DeleteExpenseCommand}"
                   Padding="18,10" Margin="6,0" FontSize="13" FontWeight="SemiBold"
                   Foreground="White" BorderThickness="1" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource NeonPinkBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource NeonPinkBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#EC4899" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EC4899" Offset="0"/>
                                            <GradientStop Color="#F472B6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
